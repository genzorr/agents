{
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__CLAUDE_NOTIFY__ \"Waiting for permission...\""
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__CLAUDE_NOTIFY__ \"Claude needs your input\""
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__CLAUDE_NOTIFY__ \"Compacting session...\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__CLAUDE_NOTIFY__ \"Response complete\""
          }
        ]
      }
    ]
  }
}
