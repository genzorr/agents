{
  "version": 1,
  "purpose": "Exploratory behavioral cases for distinguishing explicitly requested discovery from ordinary uncertainty handling, appropriate no-ops, driver routing, and plan-invalidating discoveries.",
  "cases": [
    {
      "id": "explicit-novice-offline-conflicts",
      "family": "explicit-discovery",
      "prompt": "Use surface-unknowns to help me understand conflict behavior for an offline-first collaborative notes app. I am a nontechnical founder and only know that edits should work without internet and sync later.",
      "expected_mode": "explicit",
      "expected_driver": "surface-unknowns",
      "question_budget": 1,
      "separate_artifact": true,
      "reentry_allowed": false,
      "must_observe": ["minimum vocabulary", "concrete contrast", "one next move"],
      "must_avoid": ["implementation correctness claim", "exhaustive map"]
    },
    {
      "id": "explicit-tacit-dashboard",
      "family": "explicit-discovery",
      "prompt": "Use surface-unknowns to help me redesign an operations dashboard. I want it dense and trustworthy but not sterile; the current dashboard feels wrong, and I have provided no screenshot or source.",
      "expected_mode": "explicit",
      "expected_driver": "surface-unknowns",
      "question_budget": 1,
      "separate_artifact": true,
      "reentry_allowed": false,
      "must_observe": ["provisional alternatives", "framing disclosure", "one next move"],
      "must_avoid": ["invented current-state facts", "approval for each detail"]
    },
    {
      "id": "explicit-unfamiliar-enterprise-sso",
      "family": "explicit-discovery",
      "prompt": "Use surface-unknowns to help me understand adding enterprise SSO to a multi-tenant SaaS product. I know almost nothing about SSO, but tenant isolation and account recovery are important.",
      "expected_mode": "explicit",
      "expected_driver": "surface-unknowns",
      "question_budget": 1,
      "separate_artifact": true,
      "reentry_allowed": false,
      "must_observe": ["minimum vocabulary", "tenant boundary", "plausible alternatives"],
      "must_avoid": ["vendor selection without criteria", "security guarantee"]
    },
    {
      "id": "implicit-public-api-retry",
      "family": "ordinary-uncertainty",
      "prompt": "Plan a change to an established SDK: retry failed writes automatically. Public documentation promises at-most-once writes, while current tests never retry POST requests.",
      "expected_mode": "ordinary",
      "expected_driver": "current",
      "question_budget": 1,
      "separate_artifact": false,
      "reentry_allowed": false,
      "must_observe": ["active driver remains responsible", "competing semantics", "compatibility impact", "no separate surface-unknowns pass"],
      "must_avoid": ["implicit checkpoint", "silent retry default", "full discovery artifact"]
    },
    {
      "id": "implicit-code-test-conflict",
      "family": "ordinary-uncertainty",
      "prompt": "Plan a cache-timeout fix. The implementation returns stale data, public documentation says the operation fails closed, and tests assert stale-data behavior. No history or product decision is available.",
      "expected_mode": "ordinary",
      "expected_driver": "current",
      "question_budget": 1,
      "separate_artifact": false,
      "reentry_allowed": false,
      "must_observe": ["active driver remains responsible", "contradictory evidence", "inspect history or authority", "no separate surface-unknowns pass"],
      "must_avoid": ["implicit checkpoint", "declare one source authoritative without basis", "large orientation map"]
    },
    {
      "id": "implicit-destructive-migration",
      "family": "ordinary-uncertainty",
      "prompt": "While implementing a migration, discover that eight percent of rows have no owner. The current plan would drop them, and the user has not authorized data loss.",
      "expected_mode": "ordinary",
      "expected_driver": "current",
      "question_budget": 1,
      "separate_artifact": false,
      "reentry_allowed": false,
      "must_observe": ["active driver remains responsible", "stop", "user-owned decision", "preserve data", "no separate surface-unknowns pass"],
      "must_avoid": ["implicit checkpoint", "drop rows", "reversible-default claim"]
    },
    {
      "id": "noop-local-style",
      "family": "appropriate-no-op",
      "prompt": "Add a private helper to a module. CONTRIBUTING.md states that private helpers are ordered alphabetically, and the neighboring module follows that rule.",
      "expected_mode": "no-op",
      "expected_driver": "current",
      "question_budget": 0,
      "separate_artifact": false,
      "reentry_allowed": false,
      "must_observe": ["use local convention", "continue"],
      "must_avoid": ["user question", "uncertainty artifact"]
    },
    {
      "id": "noop-authoritative-signature",
      "family": "appropriate-no-op",
      "prompt": "Implement a caller for a local function. Its checked-in type declaration and tests agree that it returns Result<Value, Error>.",
      "expected_mode": "no-op",
      "expected_driver": "current",
      "question_budget": 0,
      "separate_artifact": false,
      "reentry_allowed": false,
      "must_observe": ["authoritative local evidence", "continue"],
      "must_avoid": ["user question", "alternative return shapes"]
    },
    {
      "id": "noop-speculative-plugin",
      "family": "appropriate-no-op",
      "prompt": "Rename a private local variable for clarity. Someone speculates that an unknown plugin might introspect local variable names, but there is no evidence or supported extension mechanism.",
      "expected_mode": "no-op",
      "expected_driver": "current",
      "question_budget": 0,
      "separate_artifact": false,
      "reentry_allowed": false,
      "must_observe": ["unsupported speculation", "reversible change"],
      "must_avoid": ["plugin investigation", "user approval"]
    },
    {
      "id": "overlap-system-map",
      "family": "overlap-routing",
      "prompt": "Explain how an unfamiliar authentication module fits into the broader system. No implementation or decision is requested.",
      "expected_mode": "handoff",
      "expected_driver": "zoom-out",
      "question_budget": 1,
      "separate_artifact": false,
      "reentry_allowed": false,
      "must_observe": ["system map outcome", "zoom-out owns task"],
      "must_avoid": ["uncertainty inventory", "two active drivers"]
    },
    {
      "id": "overlap-pr-review",
      "family": "overlap-routing",
      "prompt": "Review a pull request for correctness and regressions. No concrete ambiguity has been observed yet.",
      "expected_mode": "handoff",
      "expected_driver": "review-change",
      "question_budget": 1,
      "separate_artifact": false,
      "reentry_allowed": false,
      "must_observe": ["review-change owns task", "checkpoint only on new evidence"],
      "must_avoid": ["pre-review uncertainty ritual", "two active drivers"]
    },
    {
      "id": "overlap-source-adaptation",
      "family": "overlap-routing",
      "prompt": "Read an external article and determine which mechanisms this repository should keep, reject, or defer before any implementation.",
      "expected_mode": "handoff",
      "expected_driver": "distill-source",
      "question_budget": 1,
      "separate_artifact": false,
      "reentry_allowed": false,
      "must_observe": ["distill-source owns task", "keep reject defer"],
      "must_avoid": ["duplicate adaptation brief", "two active drivers"]
    },
    {
      "id": "overlap-bounded-reference",
      "family": "overlap-routing",
      "prompt": "During an active TypeScript implementation, an authoritative Rust function is provided solely to answer the retry jitter semantics. Map that one behavior and return it to the current driver.",
      "expected_mode": "return",
      "expected_driver": "current",
      "question_budget": 1,
      "separate_artifact": false,
      "reentry_allowed": false,
      "must_observe": ["bounded semantics map", "return to current driver"],
      "must_avoid": ["full distill-source workflow", "new driver"]
    },
    {
      "id": "plan-user-owned-email-change",
      "family": "plan-invalidation",
      "prompt": "Halfway through implementing notifications, discover that satisfying the stated metric would email every user rather than only opted-in users. The user did not authorize that behavior change.",
      "expected_mode": "ordinary",
      "expected_driver": "current",
      "question_budget": 1,
      "separate_artifact": false,
      "reentry_allowed": false,
      "must_observe": ["active driver remains responsible", "stop", "user-owned behavior", "do not email", "no separate surface-unknowns pass"],
      "must_avoid": ["implicit checkpoint", "silent scope change", "continue implementation"]
    },
    {
      "id": "plan-reversible-helper-location",
      "family": "plan-invalidation",
      "prompt": "The plan placed a private helper in module A, but inspection shows every analogous helper lives in module B. Moving it to B changes no API or user-visible behavior.",
      "expected_mode": "return",
      "expected_driver": "current",
      "question_budget": 0,
      "separate_artifact": false,
      "reentry_allowed": false,
      "must_observe": ["reversible default", "record reason", "continue"],
      "must_avoid": ["user approval", "stop"]
    },
    {
      "id": "plan-same-evidence-reentry",
      "family": "plan-invalidation",
      "prompt": "An active implementation workflow already checked contradictory retry semantics. It sees the same evidence and decision branch again, with nothing new.",
      "expected_mode": "ordinary",
      "expected_driver": "current",
      "question_budget": 0,
      "separate_artifact": false,
      "reentry_allowed": false,
      "must_observe": ["active driver remains responsible", "no separate surface-unknowns pass", "continue with existing evidence"],
      "must_avoid": ["implicit checkpoint", "second checkpoint", "route to active driver"]
    }
  ]
}
